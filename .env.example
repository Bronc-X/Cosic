COSIC_LLM_BASE_URL=https://testvideo.site/v1
COSIC_LLM_API_KEY=replace_me
COSIC_LLM_MODEL=gpt-5.4
COSIC_LLM_TIMEOUT_MS=30000

# Music: personal NetEase bridge. This is intended for your own bridge/proxy endpoint.
COSIC_MUSIC_PROVIDER=netease
COSIC_MUSIC_BASE_URL=
COSIC_MUSIC_API_KEY=
COSIC_MUSIC_COOKIE=
COSIC_UNM_ENABLED=true
COSIC_UNM_FOLLOW_SOURCE_ORDER=true
COSIC_UNM_SOURCES=pyncmd,migu,kugou,bilibili,kuwo,bodian,ytdlp
COSIC_YTDLP_PATH=tools/yt-dlp.exe

# Voice: official Fish Audio API.
COSIC_VOICE_PROVIDER=fish-audio
COSIC_VOICE_BASE_URL=https://api.fish.audio
COSIC_VOICE_API_KEY=
COSIC_VOICE_MODEL=

# Calendar: official Feishu self-built app.
COSIC_CALENDAR_PROVIDER=feishu
COSIC_CALENDAR_BASE_URL=https://open.feishu.cn/open-apis
COSIC_CALENDAR_APP_ID=
COSIC_CALENDAR_APP_SECRET=

# Weather: official OpenWeather API.
COSIC_WEATHER_PROVIDER=openweather
COSIC_WEATHER_BASE_URL=https://api.openweathermap.org/data/2.5
COSIC_WEATHER_API_KEY=

# Cast: local-network discovery, no external API key.
COSIC_CAST_PROVIDER=upnp
COSIC_CAST_ENABLED=false
COSIC_CAST_DISCOVERY_TARGET=
