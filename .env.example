COSIC_LLM_BASE_URL=https://api.openai.com/v1
COSIC_LLM_API_KEY=
COSIC_LLM_MODEL=gpt-5.5
COSIC_LLM_PROXY_URL=
COSIC_LLM_TIMEOUT_MS=120000
COSIC_LLM_CURATION_TIMEOUT_MS=20000
COSIC_IMAGE_BASE_URL=https://api.openai.com/v1
COSIC_IMAGE_API_KEY=
COSIC_IMAGE_MODEL=gpt-image-1.5
COSIC_IMAGE_TIMEOUT_MS=90000
COSIC_OLLAMA_MODELS_DIR=
COSIC_OLLAMA_ALLOW_RESTART=true

# Music: personal NetEase bridge. This is intended for your own bridge/proxy endpoint.
COSIC_MUSIC_PROVIDER=netease
COSIC_MUSIC_BASE_URL=
COSIC_MUSIC_API_KEY=
COSIC_MUSIC_COOKIE=
COSIC_UNM_ENABLED=true
COSIC_UNM_FOLLOW_SOURCE_ORDER=true
COSIC_UNM_SOURCES=pyncmd,migu,kugou,bilibili,kuwo,bodian,ytdlp
COSIC_YTDLP_PATH=tools/yt-dlp.exe

# Voice: local CosyVoice FastAPI. npm run dev starts it automatically.
COSIC_VOICE_PROVIDER=cosyvoice
COSIC_VOICE_BASE_URL=http://127.0.0.1:50000
COSIC_VOICE_MODE=sft
COSIC_VOICE_SPK_ID=中文女
COSIC_VOICE_INSTRUCT_TEXT=用温柔、自然、克制的电台旁白语气朗读。
COSIC_VOICE_TIMEOUT_MS=90000
COSIC_VOICE_MAX_TEXT_CHARS=260

# Calendar: official Feishu self-built app.
COSIC_CALENDAR_PROVIDER=feishu
COSIC_CALENDAR_BASE_URL=https://open.feishu.cn/open-apis
COSIC_CALENDAR_APP_ID=
COSIC_CALENDAR_APP_SECRET=

# Weather: no-key Open-Meteo provider.
COSIC_WEATHER_PROVIDER=open-meteo

# Cast: local-network discovery, no external API key.
COSIC_CAST_PROVIDER=upnp
COSIC_CAST_ENABLED=false
COSIC_CAST_DISCOVERY_TARGET=
